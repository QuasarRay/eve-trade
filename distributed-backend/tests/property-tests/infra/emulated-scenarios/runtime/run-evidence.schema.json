{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eve-trade.invalid/schemas/emulation-run-evidence-v1.json",
  "title": "EVE Trade deterministic emulation run evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "scenario_revision",
    "run_id",
    "namespace",
    "AnySystem_revision",
    "AnySystem_seed",
    "controller_trace",
    "source_revision",
    "deployment_artifact_revisions",
    "witness_outcomes",
    "dagger_action_trace",
    "prerequisite_witness",
    "observations",
    "physical_timing"
  ],
  "properties": {
    "schema_version": {"const": "eve-trade.emulation-run-evidence/v1"},
    "scenario_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "scenario_revision": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
    "namespace": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
    "AnySystem_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "AnySystem_seed": {"type": "integer", "minimum": 0},
    "controller_trace": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "source_revision": {"type": "string", "minLength": 1},
    "deployment_artifact_revisions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": ["string", "object", "array"]}
    },
    "witness_outcomes": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "dagger_action_trace": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "prerequisite_witness": {"$ref": "prerequisite-witness.schema.json"},
    "observations": {"$ref": "observations.schema.json"},
    "physical_timing": {
      "type": "object",
      "required": ["started_at", "finished_at"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
